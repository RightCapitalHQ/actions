{
  "name": "@rightcapital/actions",
  "version": "0.0.0",
  "private": true,
  "description": "RightCapital's centralized reusable GitHub Actions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RightCapitalHQ/actions.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "change": "nx release plan",
    "check": "nx run-many -t lint format:check typecheck",
    "fix": "pnpm run lint:fix && pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@nx/js": "23.1.2",
    "@rightcapital/eslint-config": "69.0.0",
    "@rightcapital/prettier-config": "8.0.5",
    "@rslib/core": "0.23.2",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "execa": "10.0.1",
    "nx": "23.1.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.21.0"
}
